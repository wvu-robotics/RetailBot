        <color rgba="0.615686 0.811765 0.929412 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0871301 0.0548396 0.499829" rpy="4.13725e-16 8.38953e-15 -2.77556e-17"/>
      <geometry>
        <mesh filename="package://rb_description/meshes/z.stl"/>
